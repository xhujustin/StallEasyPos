# 請用下列指令各自產生，不要沿用範例值：
# openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_a_long_random_password

# openssl rand -hex 32
SECRET_KEY=replace_with_a_64_character_random_hex_string

# 第一次啟動會建立預設使用者與店鋪；腳本具冪等性。
SEED_INITIAL_DATA=true

# 依 backend/scripts/setup_defaults.py 建立 admin/000000、owner/111111 與店鋪 PIN。
SETUP_DEFAULT_CREDENTIALS=true

# 是否載入示範商品。
SEED_SAMPLE_PRODUCTS=false
